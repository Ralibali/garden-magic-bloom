{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.odlingsdagboken.com"
        }
      ],
      "destination": "https://odlingsdagboken.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/manad/:slug",
      "destination": "/odlingskalender/:slug",
      "statusCode": 301
    },
    {
      "source": "/vaxtguider",
      "destination": "/vaxter",
      "statusCode": 301
    },
    {
      "source": "/villkor",
      "destination": "/terms",
      "statusCode": 301
    },
    {
      "source": "/integritet",
      "destination": "/terms#integritet",
      "statusCode": 301
    },
    {
      "source": "/pris",
      "destination": "/priser",
      "statusCode": 301
    },
    {
      "source": "/guider",
      "destination": "/blogg",
      "statusCode": 301
    },
    {
      "source": "/guider/:slug",
      "destination": "/blogg/:slug",
      "statusCode": 301
    },
    {
      "source": "/manad",
      "destination": "/odlingskalender",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/app/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/reset-password",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/auth/:path*",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/auth/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/faltdagbok",
      "destination": "/app.html"
    },
    {
      "source": "/radera-konto",
      "destination": "/app.html"
    },
    {
      "source": "/login",
      "destination": "/app.html"
    },
    {
      "source": "/install",
      "destination": "/app.html"
    },
    {
      "source": "/reset-password",
      "destination": "/app.html"
    }
  ]
}
